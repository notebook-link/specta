{
  "jupyter-config-data": {
    "enableMemoryStorage": true,
    "contentsStorageDrivers": ["memoryStorageDriver"],
    "spectaConfig": {
      "topBar": {
        "title": "Specta Tree"
      },
      "uiSwitcherOptions": [
        {
          "id": "lab",
          "label": "JupyterLab"
        },
        {
          "id": "notebooks",
          "label": "Notebook"
        },
        {
          "id": "specta",
          "label": "Specta"
        }
      ],
      "defaultLayout": "article",
      "perFileConfig": {
        "blog.ipynb": {
          "hideTopbar": false,
          "defaultLayout": "article"
        },
        "slides.ipynb": {
          "hideTopbar": true,
          "slidesTheme": "sky"
        },
        "static-rendering.ipynb": {
          "hideTopbar": false,
          "defaultLayout": "article",
          "topBar": {
            "title": "Static rendering"
          }
        }
      },
      "labConfig": {
        "setSingleMode": true,
        "hideLeftPanel": true,
        "hideRightPanel": true,
        "hideStatusbar": true,
        "hideHeader": false
      }
    },
    "disabledExtensions": ["@jupyterlab/notebook-extension:open-with-no-kernel"]
  }
}
